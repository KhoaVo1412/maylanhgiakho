<IfModule mod_rewrite.c>
    RewriteEngine On

    # Cho phép truy cập tệp HTML xác minh của Google mà không rewrite vào public/
    RewriteCond %{REQUEST_URI} ^/google914a126c2a1906d3.html$ [NC]
    RewriteRule ^(.*)$ - [L]

    # Chuyển hướng tất cả các yêu cầu đến thư mục public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

